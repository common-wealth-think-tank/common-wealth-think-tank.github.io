           <div class="tt-row">Cluster: ${d.cluster}</div>
           <div class="tt-row">Department: ${d.department}</div>
           <div class="tt-row">Legal status: ${d.legal ?? "—"}</div>`;
    }
    function moveTooltip(event) {
      tooltip.style.left = (event.pageX + 14) + "px";
      tooltip.style.top = (event.pageY - 10) + "px";
    }
    function hideTooltip() { tooltip.style.opacity = "0"; }

    // Chart

    function buildChart(svgEl, nodes, edges, clusterCentroids) {

      // Simulation
      const nodeMap = new Map(nodes.map(n => [n.id, n]));

      d3.forceSimulation(nodes)
        .force("link", d3.forceLink(edges)
          .id(d => d.id)
          .distance(d => {
            const src = nodeMap.get(d.source.id ?? d.source);
            const tgt = nodeMap.get(d.target.id ?? d.target);
            return (src?.type === "department" || tgt?.type === "department") ? 110 : 80;
          })
          .strength(0.6)
        )
        .force("charge", d3.forceManyBody()
          .strength(d => d.type === "department" ? -400 : -180)
        )
        .force("collision", d3.forceCollide()
          .radius(d => nodeRadius(d) + 14)
        )
        .force("clusterX", d3.forceX(d => clusterCentroids[d.cluster]?.x ?? 0).strength(0.18))
        .force("clusterY", d3.forceY(d => clusterCentroids[d.cluster]?.y ?? 0).strength(0.18))
        .force("centerX", d3.forceX(0).strength(0.03))
        .force("centerY", d3.forceY(0).strength(0.03))
        .stop()       
        .tick(300);  

      // Viewbox comes from node position
      const pad = 60;
      const minX = d3.min(nodes, d => d.x) - pad;
      const minY = d3.min(nodes, d => d.y) - pad;
      const maxX = d3.max(nodes, d => d.x) + pad;
      const maxY = d3.max(nodes, d => d.y) + pad;
      const vbW = maxX - minX;
      const vbH = maxY - minY;

      const svg = d3.select(svgEl)
        .attr("viewBox", `${minX} ${minY} ${vbW} ${vbH}`)
        .attr("preserveAspectRatio", "xMidYMid meet");

      svgEl.style.aspectRatio = `${vbW} / ${vbH}`;

      const g = svg.append("g");
      const clusterLayer = g.append("g");
      const edgeLayer = g.append("g");
      const nodeLayer = g.append("g");
      const labelLayer = g.append("g");

      const clusters = [...new Set(nodes.filter(n => n.cluster).map(n => n.cluster))];

      // Hulls
      clusterLayer.selectAll("path.hull")
        .data(clusters)
        .join("path")
        .attr("class", "hull")
        .attr("d", name =>
          hullPath(nodes.filter(n => n.cluster === name).map(n => [n.x, n.y]), 36) ?? ""
        )
        .attr("fill", "#F1EBE4")

      // Cluster labels
      clusterLayer.selectAll("text.cluster-name")
        .data(clusters)
        .join("text")
        .attr("class", "cluster-name")
        .text(d => d)
        .attr("x", name => {
          const pts = nodes.filter(n => n.cluster === name).map(n => n.x);
          return d3.min(pts) - 4;
        })
        .attr("y", name => {
          const pts = nodes.filter(n => n.cluster === name).map(n => n.y);
          return d3.min(pts) - 44;
        })
        .attr("fill", "#555")
        .attr("font-family", "'JetBrains Mono', monospace")
        .attr("font-size", "8px")
        .attr("font-weight", "300")
        .attr("letter-spacing", "0.06em")
        .attr("pointer-events", "none");

      // Edges
      edgeLayer.selectAll("line")
        .data(edges)
        .join("line")
        .attr("x1", d => d.source.x)
        .attr("y1", d => d.source.y)
        .attr("x2", d => d.target.x)
        .attr("y2", d => d.target.y)
        .attr("stroke", d => edgeStyle[d.function]?.stroke ?? "#333")
        .attr("stroke-width", d => edgeStyle[d.function]?.width ?? 1.5)
        .attr("stroke-dasharray", d => edgeStyle[d.function]?.dasharray ?? null)
        .attr("opacity", 0.85);

      // Nodes
      const nodeSel = nodeLayer.selectAll("g.node")
        .data(nodes)
        .join("g")
        .attr("class", "node")
        .attr("transform", d => `translate(${d.x},${d.y})`)
        .style("cursor", "pointer")
        .on("mouseover", showTooltip)
        .on("mousemove", moveTooltip)
        .on("mouseout", hideTooltip);

      nodeSel.filter(d => d.type === "department")
        .append("rect")
        .attr("width", d => nodeRadius(d) * 1.8)
        .attr("height", d => nodeRadius(d) * 1.8)
        .attr("x", d => -nodeRadius(d) * 0.9)
        .attr("y", d => -nodeRadius(d) * 0.9)
        .attr("transform", "rotate(45)")
        .attr("fill", nodeColour);

      nodeSel.filter(d => d.type === "institution")
        .append("circle")
        .attr("r", nodeRadius)
        .attr("fill", nodeColour);

      // Abbreviation labels
      labelLayer.selectAll("text")
        .data(nodes)
        .join("text")
        .attr("x", d => d.x)
        .attr("y", d => d.y)
        .text(d => d.abbr ?? d.name)
        .attr("text-anchor", "middle")
        .attr("dominant-baseline", "central")
        .attr("fill", d => d.abbr === "UKGI" ? "#333" : "#fff")
        .attr("font-family", "'JetBrains Mono', monospace")
        .attr("font-size", d => d.type === "department" ? "10px" : "8px")
        .attr("font-weight", d => d.type === "department" ? "500" : "400")
        .attr("pointer-events", "none");
    }

