    // Shared legend 

    (function drawLegend() {
      const el = document.getElementById("legend");

      const section = (title, rows) =>
        `<div style="margin-bottom:10px;flex:0 0 auto">
          <div style="font-size:8px;font-weight:500;letter-spacing:0.1em;color:#777;margin-bottom:4px">${title.toUpperCase()}</div>
