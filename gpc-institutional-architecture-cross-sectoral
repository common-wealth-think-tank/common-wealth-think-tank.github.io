      { label: "Regulatory body", color: "#453643" },
      { label: "Judicial body", color: "#A0ECD0" },
    ];

    const institutionTypeColour = Object.fromEntries(
      institutionTypes.map(d => [d.label, d.color])
    );

    const edgeStyle = {
      "Financing": { stroke: "#333", dasharray: null, width: 1.5 },
      "Advisory": { stroke: "#333", dasharray: "5,3", width: 1.5 },
      "Regulatory": { stroke: "#333", dasharray: "8,3,2,3", width: 1.5 },
      "Executive": { stroke: "#333", dasharray: "1.5,3", width: 1.5 },
      "Judicial": { stroke: "#333", dasharray: "8,2", width: 1.5 },
    };

    const edgeTypes = Object.entries(edgeStyle)
      .map(([label, s]) => ({ label, dasharray: s.dasharray }));

    function nodeRadius(d) { return d.type === "department" ? 28 : 14; }

    function nodeColour(d) {
      if (d.type === "department") return "#333";
      return institutionTypeColour[d.institutionType] ?? "#7a8399";
    }

    // Cluster hulls

    function hullPath(points, padding) {
      if (!points.length) return null;
      if (points.length === 1) {
        const [x, y] = points[0];
        const r = padding * 0.5;
        return hullPath(
          Array.from({ length: 4 }, (_, i) => {
            const a = (i / 4) * 2 * Math.PI;
            return [x + r * Math.cos(a), y + r * Math.sin(a)];
          }), padding
        );
      }
      if (points.length === 2) {
        const dx = points[1][0] - points[0][0];
        const dy = points[1][1] - points[0][1];
        const len = Math.sqrt(dx * dx + dy * dy) || 1;
        const ux = -dy / len * padding, uy = dx / len * padding;
        return `M${points[0][0] + ux},${points[0][1] + uy}
                L${points[1][0] + ux},${points[1][1] + uy}
                L${points[1][0] - ux},${points[1][1] - uy}
                L${points[0][0] - ux},${points[0][1] - uy}Z`;
      }
      const hull = d3.polygonHull(points);
      if (!hull) return null;
      const cx = d3.mean(hull, p => p[0]);
      const cy = d3.mean(hull, p => p[1]);
      return "M" + hull.map(p => {
        const dx = p[0] - cx, dy = p[1] - cy;
        const len = Math.sqrt(dx * dx + dy * dy) || 1;
        return [p[0] + dx / len * padding, p[1] + dy / len * padding].join(",");
      }).join("L") + "Z";
    }

    // Tooltips

    const tooltip = document.getElementById("tooltip");

    function showTooltip(event, d) {
      tooltip.style.opacity = "1";
      tooltip.innerHTML = d.type === "department"
        ? `<strong>${d.name}</strong><div class="tt-row">Government department</div>`
        : `<strong>${d.name}</strong>
