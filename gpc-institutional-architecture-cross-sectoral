    }

    .tooltip {
      position: absolute;
      background: #fff;
      border: 1px solid #333;
      padding: 8px;
      font-size: 10px;
      opacity: 0;
      transition: opacity 0.15s;
      max-width: 220px;
      line-height: 1.4;
      pointer-events: none;
      z-index: 10;
    }

    .tooltip strong {
      display: block;
      margin-bottom: 4px;
    }

    .tt-row {
      margin-bottom: 2px;
    }
  </style>
</head>

