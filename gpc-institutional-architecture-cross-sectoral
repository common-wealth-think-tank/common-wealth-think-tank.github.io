      const circleRow = (color, label) =>
        `<div style="display:flex;align-items:center;gap:8px;margin-bottom:2px">
          <svg width="14" height="14"><circle cx="7" cy="7" r="5" fill="${color}"/></svg>
          <span>${label}</span>
        </div>`;

      const diamondRow = (color, label) =>
        `<div style="display:flex;align-items:center;gap:8px;margin-bottom:2px">
          <svg width="14" height="14"><rect x="3" y="3" width="8" height="8" transform="rotate(45,7,7)" fill="${color}"/></svg>
          <span>${label}</span>
        </div>`;

      const edgeRow = (dasharray, label) =>
        `<div style="display:flex;align-items:center;gap:8px;margin-bottom:2px">
          <svg width="20" height="14"><line x1="0" y1="7" x2="20" y2="7" stroke="#333" stroke-width="1.5" ${dasharray ? `stroke-dasharray="${dasharray}"` : ""}></line></svg>
          <span>${label}</span>
        </div>`;

      el.innerHTML = [
        section("Node type", [
          diamondRow("#333", "Government department"),
          circleRow("#333", "Institution"),
